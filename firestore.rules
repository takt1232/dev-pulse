rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.email == 'gabskie.hsdpmarketing@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (getUserData(request.auth.uid).role == 'Owner' ||
          getUserData(request.auth.uid).role == 'admin'))
      );
    }

    function isProjectOwner(projectId) {
      return projectId != null &&
             exists(/databases/$(database)/documents/projects/$(projectId)) &&
             get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        isOwner() ||
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
      );
      allow delete: if isOwner();
    }

    // Projects (Multi-tenant workspaces)
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      // Any authenticated user can create their own project and become owner
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      // Only project owner (or system admin) can update project details or manage collaborators
      allow update: if isAuthenticated() && (
        isOwner() ||
        resource.data.ownerId == request.auth.uid
      );
      // Only project owner (or system admin) can delete the project
      allow delete: if isAuthenticated() && (
        isOwner() ||
        resource.data.ownerId == request.auth.uid
      );
    }

    // Tasks and bug tickets
    match /tasks/{taskId} {
      allow read: if isAuthenticated();

      // Creation rule: Collaborators cannot set initial status to 'done' or assign other users
      allow create: if isAuthenticated() && (
        isOwner() || isProjectOwner(request.resource.data.projectId) || (
          request.resource.data.status != 'done' &&
          (request.resource.data.assigneeId == null || request.resource.data.assigneeId == request.auth.uid)
        )
      );

      // Update rule: Only Owner can set status to 'done' or change assignee
      allow update: if isAuthenticated() && (
        isOwner() || isProjectOwner(resource.data.projectId) || (
          // Collaborator must not change status to 'done'
          request.resource.data.status != 'done' &&
          // Collaborator cannot reassign or change assigneeId
          request.resource.data.assigneeId == resource.data.assigneeId
        )
      );

      // Delete rule: Owner or original reporter
      allow delete: if isAuthenticated() && (
        isOwner() || isProjectOwner(resource.data.projectId) || resource.data.reporterId == request.auth.uid
      );
    }

    // Comments
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        isOwner() || resource.data.authorId == request.auth.uid
      );
    }

    // Activity Logs
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
  }
}
